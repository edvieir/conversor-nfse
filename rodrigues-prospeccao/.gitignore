# Base bruta da Receita Federal (~25 GB) - nunca versionar
dados_rfb/*
!dados_rfb/.gitkeep

# Saidas geradas
saidas/*
!saidas/.gitkeep

# Dados de prospects - contem CNPJ e telefone de terceiros.
# O CRM de trabalho NUNCA e versionado. So o modelo em branco (CRM_MODELO.xlsx),
# que serve para recriar o arquivo em uma maquina nova.
crm/*.xlsx
!crm/CRM_MODELO.xlsx
*.csv

# Chaves
.env
*.key

# Python
__pycache__/
*.pyc
.venv/
venv/
